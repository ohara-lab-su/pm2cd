def DeviceProxy(device_class: Literal['PM2CD', 'pm2cd'], *args: Any, async_mode: Literal[False], **kwargs: Any) -> SyncPM2CDClient: ...
@overload
def DeviceProxy(device_class: Literal['PM2CD', 'pm2cd'], *args: Any, async_mode: None = None, **kwargs: Any) -> AsyncPM2CDClient: ...
def DeviceProxy(device_class: str, *args: Any, async_mode: bool | None = None, **kwargs: Any) -> AsyncPM2CDClient | SyncPM2CDClient: ...

def create_device_proxy(device_class: Literal['PM2CD', 'pm2cd']) -> Callable[..., AsyncPM2CDClient | SyncPM2CDClient]: ...
